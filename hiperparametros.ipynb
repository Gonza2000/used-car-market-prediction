# 4. Pipeline Final con XGBoost
pipeline_xgb = Pipeline(steps=[
    ('preprocesador', make_preprocessor(escalar_numericas=False)),
    ('modelo', xgb.XGBRegressor(
        n_estimators=200,   # Hiperparámetro: Número de árboles
        learning_rate=0.1,  # Hiperparámetro: Tasa de aprendizaje
        max_depth=7,        # Hiperparámetro: Profundidad máxima del árbol
        random_state=42,
        n_jobs=-1
    ))
])

pipeline_cat_alta = Pipeline(steps=[
        ('imputador', SimpleImputer(strategy='constant', fill_value='unknown')),
        ('target_encoder', TargetEncoder(smoothing=10)) # Hiperparámetro de suavizado
    ])

# ==========================================================
# MODELO 3: Regresión Ridge (Regularización L2)
# ==========================================================
pipeline_ridge = Pipeline(steps=[
    ('preprocesador', make_preprocessor(escalar_numericas=True)),
    ('modelo', Ridge(alpha=10.0)) # Hiperparámetro: Fuerza de regularización L2
])
